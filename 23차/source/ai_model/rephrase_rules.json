{
  "format": "pxe-train-rephrase-rules-v1",
  "scope": "고정 train의 COPY·인용 바깥에서만 사용하는 지도 학습 표현 편집. 추론용 의미 파서가 아님",
  "rules": [
    {"id":"back","source":"뒤로 가","variants":["뒤로 버튼을 눌러","뒤로가기를 실행해","직전 화면으로 이동해","한 번 뒤로 돌아가"],"meaning":"BACK 한 번. 등록 literal 내부에는 적용 금지"},
    {"id":"home","source":"홈으로 가","variants":["홈 버튼을 눌러","홈 화면으로 이동해","홈으로 돌아가 줘","휴대전화 홈을 표시해"],"meaning":"HOME"},
    {"id":"recents","source":"최근 앱을 열어","variants":["최근 사용 앱 목록을 열어","현재 앱 전환 목록을 보여 줘","최근 실행 앱 화면을 열어","최근 앱 화면을 띄워 줘"],"meaning":"RECENTS"},
    {"id":"notifications","source":"알림 패널을 열어","variants":["알림 패널을 펼쳐","알림 패널이 나오게 해","휴대전화 알림 패널을 표시해","알림 패널을 내려 열어"],"meaning":"NOTIFICATIONS"},
    {"id":"stop","source":"매크로를 정지해","variants":["현재 매크로를 중단해","매크로를 멈춰 줘","매크로 동작을 끝내 줘","매크로 수행을 정지시켜"],"meaning":"STOP. 앱 종료나 결제 취소로 해석하지 않음"},
    {"id":"wait","source":" 기다려","variants":[" 대기해"," 동안 조작을 멈추고 기다려"," 대기 상태로 있어"," 기다리고 있어"],"meaning":"앞의 숫자·단위를 그대로 유지한 WAIT"},
    {"id":"input","source":"라고 입력해","variants":["라는 내용을 입력해 줘","라는 문구를 입력란에 적어 넣어","라고 텍스트를 입력해","라는 문자열을 입력해 주세요"],"meaning":"INPUT literal을 동일하게 입력"},
    {"id":"text_tap","source":" 글자를 찾아 눌러","variants":[" 글자를 탐색해서 터치해"," 글자 위치를 찾아 누르는 동작을 해"," 글자가 있는 곳을 검색해 눌러 줘"," 글자를 찾은 다음 그 글자를 터치해"],"meaning":"TEXT_TAP 동일 문구 검색 뒤 클릭"},
    {"id":"text_wait","source":" 글자가 보일 때까지 ","variants":[" 글자가 나타날 때까지 "," 글자의 등장을 기다리며 "," 글자가 화면에 나올 때까지 "," 글자가 등장할 때까지 "],"meaning":"TEXT_WAIT. 뒤에 있는 고정3초와 탐색 동사를 유지"},
    {"id":"text_check","source":" 글자가 있는지 확인해","variants":[" 글자의 존재를 확인해"," 글자가 화면에 있는지 검사해"," 글자가 존재하는지 판단해"," 글자가 보이는 상태인지 확인해 줘"],"meaning":"TEXT_CHECK 한 번의 검색 확인"},
    {"id":"forever_text","source":" 글자가 나타날 때까지 시간 제한 없이 기다려","variants":[" 글자를 발견할 때까지 제한 시간 없이 대기해"," 글자가 나올 때까지 시간을 제한하지 말고 기다려"," 글자가 보일 때까지 기한을 두지 않고 대기해"," 글자의 등장을 시간 상한 없이 계속 기다려"],"meaning":"TEXT_WAIT 또는 TEXT_TAP의 wait_forever=True"},
    {"id":"found_tap","source":"찾으면 터치해","variants":["찾았을 때 해당 글자를 터치해","발견한 다음 그 위치를 눌러","발견하면 그 글자를 눌러 줘","찾은 글자를 이어서 터치해"],"meaning":"wait_forever 탐색 성공 뒤 같은 글자 TEXT_TAP"},
    {"id":"point_tap","source":" 포인트를 눌러","variants":[" 포인트를 터치해"," 등록 포인트를 눌러 줘"," 포인트 위치를 한 번 터치해","에 저장된 포인트를 눌러"],"meaning":"TAP. 등록 좌표를 그대로 사용"},
    {"id":"point_double","source":" 포인트를 두 번 눌러","variants":[" 포인트를 두 번 터치해"," 등록 포인트를 두 번 눌러 줘"," 포인트 위치를 연속 두 번 터치해"," 포인트에서 두 번 누르기를 해"],"meaning":"DOUBLE. 두 번이라는 횟수 유지"},
    {"id":"point_long","source":" 포인트를 길게 눌러","variants":[" 포인트를 길게 터치해"," 등록 포인트에서 길게 누르기를 해"," 포인트에서 길게 누르기를 수행해"," 포인트를 길게 눌러 줘"],"meaning":"LONG. 기존 길게누름 설정 유지"},
    {"id":"swipe","source":"스와이프해","variants":["직선 스와이프를 해","저장된 직선 쓸기를 수행해","직선으로 쓸어 움직여","스와이프 동작을 실행해"],"meaning":"SWIPE. 앞 등록 경로 유지"},
    {"id":"curve","source":"곡선으로 쓸어","variants":["곡선 쓸기를 수행해","곡선을 따라 쓸어","곡선 이동 동작을 해","저장된 곡선으로 터치를 이동해"],"meaning":"CURVE. 앞 등록 경로 유지"},
    {"id":"pinch_in","source":"두 손가락으로 축소해","variants":["두 손가락을 오므려 축소해","두 손가락 축소 동작을 해","두 손가락을 모으는 핀치를 해","두 손가락으로 화면을 축소해"],"meaning":"PINCH_IN. 축소 극성 유지"},
    {"id":"pinch_out","source":"두 손가락으로 확대해","variants":["두 손가락을 벌려 확대해","두 손가락 확대 동작을 해","두 손가락을 벌리는 핀치를 해","두 손가락으로 화면을 확대해"],"meaning":"PINCH_OUT. 확대 극성 유지"},
    {"id":"multi_tap","source":"동시에 터치해","variants":["여러 지점을 동시에 터치해","동시 누르기를 수행해","같은 시각에 다중 터치해","저장 지점들을 함께 눌러"],"meaning":"MULTI_TAP. 순차 클릭으로 바꾸지 않음"},
    {"id":"gesture","source":"녹화 제스처를 재생해","variants":["녹화한 제스처를 실행해","저장 녹화 제스처를 재생해 줘","기록된 제스처 동작을 재생해","녹화 제스처의 움직임을 수행해"],"meaning":"GESTURE. 기존 녹화 경로 유지"},
    {"id":"app","source":" 앱을 실행해","variants":[" 앱을 실행시켜"," 앱을 시작해 줘"," 앱 실행 동작을 해","라는 등록 앱을 실행해"],"meaning":"APP 동일 등록 앱"},
    {"id":"call","source":" 저장 매크로를 실행해","variants":[" 저장 매크로를 수행해"," 저장된 매크로를 호출해"," 저장 매크로 동작을 실행시켜","라는 보관 매크로를 실행해"],"meaning":"CALL 동일 등록 매크로 스냅샷"},
    {"id":"missing_stop","source":"없으면 정지해","variants":["없으면 매크로를 중단해","없으면 실행을 정지시켜","없으면 다음 동작 없이 멈춰","없으면 매크로 진행을 끝내"],"meaning":"미발견 F_STOP. 없음 조건 유지"},
    {"id":"missing_skip","source":"없으면 다음 동작으로 넘어가","variants":["없으면 이 동작만 건너뛰어","없으면 후속 동작을 계속해","없으면 현재 단계는 생략해","없으면 다음 단계로 진행해 줘"],"meaning":"미발견 F_SKIP. 없음 조건 유지"},
    {"id":"back_retry","source":"뒤로 가서 ","variants":["뒤로 돌아간 후 ","뒤로가기를 한 다음 ","직전 화면으로 돌아가서 ","뒤로 버튼을 누른 뒤 "],"meaning":"F_BACK_RETRY의 BACK 선행. 반복 횟수는 변경하지 않음"},
    {"id":"retry_count","source":"회 다시 찾아","variants":["회 다시 검색해","회 재탐색해","회 탐색을 재시도해","회 다시 찾아 줘"],"meaning":"COPY된 재시도 횟수와 회 단위 유지"},
    {"id":"retry_forever","source":"찾을 때까지 계속 다시 찾아","variants":["찾을 때까지 탐색을 계속 반복해","찾을 때까지 재탐색을 이어 가","찾을 때까지 멈추지 말고 다시 검색해","찾을 때까지 계속 재시도해"],"meaning":"FOREVER 재시도 종료 조건 유지"},
    {"id":"region_limit","source":" 영역으로 한정해","variants":[" 영역 안에서만 탐색해"," 영역에만 검색을 제한해"," 영역 내부로 검색 범위를 한정해"," 영역만 검색 대상으로 삼아"],"meaning":"IN_REGION 외부 영역 검색 금지"},
    {"id":"condition_present","source":" 글자가 있으면 ","variants":[" 글자가 화면에 있으면 "," 글자가 존재하는 경우 "," 글자가 나타나 있으면 "," 글자가 보인다면 "],"meaning":"IF_PRESENT THEN 극성 유지"},
    {"id":"condition_absent","source":" 글자가 없으면 ","variants":[" 글자가 화면에 없으면 "," 글자가 보이지 않으면 "," 글자가 부재한 경우 "," 글자가 나타나 있지 않으면 "],"meaning":"IF_ABSENT THEN 극성 유지"},
    {"id":"condition_else","source":"그렇지 않으면 ","variants":["반대 조건이면 ","그 조건이 아니면 ","나머지 경우에는 ","앞 조건을 만족하지 않으면 "],"meaning":"동일 IF의 ELSE. 분기 순서 유지"},
    {"id":"sequence_after","source":". 그 뒤에 ","variants":[". 그 작업 뒤에 ",". 그다음에 ",". 이어서 순서대로 ",". 직전 작업 다음에 "],"meaning":"이전 명령 다음 순서 유지"},
    {"id":"sequence_next","source":". 다음으로 ","variants":[". 그다음 순서로 ",". 이후 작업으로 ",". 앞 동작을 마친 뒤 ",". 이어서 할 일은 "],"meaning":"이전 명령 다음 순서 유지"},
    {"id":"sequence_and","source":", 그리고 ","variants":[", 그다음에 ",", 이어서 ",", 다음 순서로 ",", 앞 동작 뒤에는 "],"meaning":"직렬 명령 순서 유지"},
    {"id":"repeat_group","source":"다음 묶음을 ","variants":["이 동작 묶음을 ","아래 묶음 작업을 ","다음 작업 묶음을 ","아래 두 동작의 묶음을 "],"meaning":"REPEAT 동일 두 동작 묶음. 뒤 COPY 반복 수 유지"},
    {"id":"repeat_and","source":". 그리고 ","variants":[". 다음 동작으로 ",". 이어서 묶음 안에서 ",". 같은 묶음의 다음 동작은 ",". 묶음에서 이어 할 일은 "],"meaning":"기존 REPEAT 내부 두 번째 동작의 위치 유지"},
    {"id":"repeat_end","source":"여기까지 반복하고 ","variants":["이 묶음의 반복을 마치고 ","앞의 묶음을 모두 반복한 다음 ","묶음 반복을 끝낸 뒤 ","위 두 동작의 반복이 끝나면 "],"meaning":"END_REPEAT 뒤 STOP. STOP을 루프 안으로 이동하지 않음"},
    {"id":"watch_found","source":"를 찾으면 ","variants":["를 발견하면 ","가 탐지되면 ","를 찾아냈을 때 ","가 화면에서 발견되면 "],"meaning":"WATCH 동일 탐지 문구를 찾았을 때 등록 매크로 처리"},
    {"id":"reject_negated","source":"를 입력하지 마","variants":["는 입력하지 마","를 입력하면 안 돼","를 입력하는 동작은 금지해","를 입력하지 않도록 해"],"meaning":"REJECT NEGATED. 입력 금지 극성 유지"},
    {"id":"reject_ambiguous","source":" 말고 저기를 눌러","variants":[" 대신 저쪽을 눌러"," 말고 저 위치를 터치해"," 대신 저기를 터치해 줘"," 말고 지목한 저곳을 눌러"],"meaning":"REJECT AMBIGUOUS. 미등록 지시 위치를 구체 좌표로 바꾸지 않음"},
    {"id":"reject_missing","source":"등록되지 않은 ","variants":["저장하지 않은 ","미등록 상태인 ","등록한 적 없는 ","등록 목록에 없는 "],"meaning":"REJECT MISSING_REFERENCE. context에는 여전히 등록 없음"},
    {"id":"reject_unsupported","source":"로 결제해","variants":["로 결제를 처리해","로 결제 절차를 실행해","를 써서 결제해","로 비용을 결제해"],"meaning":"REJECT UNSUPPORTED 결제 요청. 실제 결제를 실행하지 않음"},
    {"id":"reject_incomplete","source":"가 있으면 그 다음에는","variants":["가 있으면 그 뒤에는","가 있다면 그 다음 동작은","가 있는 경우 그 다음은","가 있으면 이어서"],"meaning":"REJECT INCOMPLETE. 실행할 후속 지시가 여전히 없음"},
    {"id":"watch_count","source":"회 실행해","variants":["회 수행해","회 동작시켜","회 돌려","회 실행해 줘"],"meaning":"WATCH COPY 횟수와 회 단위를 유지"},
    {"id":"watch_cooldown_default","source":"완료 뒤에는 기본 시간만큼 쉬어","variants":["완료한 뒤 기본 휴식 시간만큼 대기해","수행을 마치면 기본값의 시간만큼 쉬어","모두 완료하고 기본 휴식 시간을 기다려","완료 후 설정된 기본 시간만큼 휴식해"],"meaning":"DEFAULT_COOLDOWN. 완료 이후 휴식 순서 유지"},
    {"id":"watch_complete","source":"완료하면 ","variants":["완료한 뒤 ","수행을 마친 다음 ","전부 마치면 ","작업 완료 후 "],"meaning":"같은 WATCH 반복 완료 뒤 cooldown"},
    {"id":"watch_rest","source":" 쉬어","variants":[" 휴식해"," 대기하며 쉬어"," 동안 휴식해"," 쉬고 있어"],"meaning":"앞 cooldown 수와 단위 유지"},
    {"id":"watch_refresh","source":"아래로 당겨 새로고침해","variants":["아래로 당기기로 새로고침해","아래쪽으로 당겨 갱신해","아래로 당기는 갱신 동작을 해","화면을 아래로 당겨 새로 고쳐"],"meaning":"WATCH interval의 PULL 갱신. 위쪽 스크롤로 바꾸지 않음"},
    {"id":"watch_region_order","source":"탐지 우선순위 영역은 ","variants":["우선순위에 따른 탐지 영역은 ","다음 순서로 탐색할 영역은 ","탐지 순서에 넣을 영역은 ","지금 순서로 탐지할 등록 영역은 "],"meaning":"WATCH_REGION 목록의 기존 순서 유지"},
    {"id":"watch_entry_before","source":"매크로 실행 전에 진입 화면에서 ","variants":["매크로를 시작하기 전 이동한 화면에서 ","매크로 수행에 앞서 진입 화면에서 ","매크로 실행의 선행 확인으로 진입 화면에서 ","매크로가 시작되기 전에 진입한 화면에서 "],"meaning":"ENTRY 확인은 CALL 실행 전"},
    {"id":"watch_entry_check","source":"가 있는지 확인해","variants":["가 존재하는지 확인해","가 화면에 있는지 검사해","가 보이는지 확인해","가 나타나 있는지 살펴봐"],"meaning":"ENTRY 동일 확인 문구 존재 검사"},
    {"id":"watch_entry_all","source":"진입 확인은 전체 화면에서 해","variants":["전체 화면을 진입 확인 범위로 써","진입 화면 전체에서 확인해","진입 확인 영역은 전체 화면으로 정해","화면 전체를 대상으로 진입을 확인해"],"meaning":"ENTRY_ALL 명시 전체. 첫 목록 영역 기본값으로 바꾸지 않음"},
    {"id":"watch_entry_timeout","source":"확인 제한은 ","variants":["확인 제한 시간은 ","진입 확인의 시간 상한은 ","확인을 기다릴 최대 시간은 ","진입 검사 제한 시간은 "],"meaning":"ENTRY_TIMEOUT COPY 수와 초 단위를 유지"},
    {"id":"watch_reject_priority","source":"이 글자가 보이면 확인 글자보다 우선해서 되돌아가","variants":["이 글자가 있으면 확인 글자에 앞서 되돌아가","이 글자를 발견하면 확인 글자보다 먼저 되돌아가","이 글자가 나타나면 확인 성공보다 우선해 되돌아가","이 글자의 탐지를 확인 글자보다 우선하여 되돌아가"],"meaning":"REJECT_TEXT가 ENTRY text보다 우선하는 극성 유지"},
